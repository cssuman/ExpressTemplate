# ==============================================================================
# Copy this file to .env.local and fill in real values.
#
# Loading order (later files override earlier ones, via dotenv-flow):
#   .env  ->  .env.local  ->  .env.<NODE_ENV>  ->  .env.<NODE_ENV>.local
#
# Every variable below is validated by src/schema/env.schema.ts at boot.
# A missing or malformed value stops the process instead of failing later.
# See docs/04-configuration.md
# ==============================================================================

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Origins allowed by CORS. Comma-separate to allow more than one.
# e.g. CLIENT_URL=https://app.example.com,https://admin.example.com
CLIENT_URL=http://localhost:3000

# Shared secret for the verifyApiKey middleware (minimum 16 characters).
# Generate one with:  openssl rand -hex 32
API_KEY=replace_me_with_a_long_random_value

# ------------------------------------------------------------------------------
# Optional - defaults shown
# ------------------------------------------------------------------------------

PORT=8080

# Morgan request-log format: dev | short | combined | common | tiny
# Use `combined` in production (includes referrer and user-agent).
LOG_LEVEL=dev

# Number of reverse proxies in front of this server.
#   false -> direct to the internet (default)
#   1     -> behind exactly one load balancer / nginx  <- most deployments
#   true  -> trust every proxy (DANGEROUS: lets clients spoof their IP)
# Getting this wrong breaks rate limiting and IP logging. See docs/09-security.md
TRUST_PROXY=false

# Skip the global rate limiter. Useful for local load testing, never in production.
DISABLE_RATE_LIMITER=false

# Skip API key checks. Only honoured when NODE_ENV=development.
DISABLE_VALIDATE_API_KEY_ON_DEVELOPMENT=false

# Require an x-api-key header on GET /metrics.
# Leave false only when the port is unreachable from the public internet.
PROTECT_METRICS=false

# Serve the interactive API reference at /docs.
# Unset means: on in development, off in production (it lists every route you
# have). Set to true deliberately if you want a public API reference.
ENABLE_API_DOCS=

# ------------------------------------------------------------------------------
# SendGrid (optional)
#
# The server boots without these. Calling the email API while unconfigured
# returns 503 with an actionable message instead of crashing at startup.
#
# API key:      https://app.sendgrid.com/settings/api_keys
# Sender auth:  https://app.sendgrid.com/settings/sender_auth/senders/new
# ------------------------------------------------------------------------------
SEND_GRID_API_KEY=
SEND_GRID_FROM_EMAIL=
