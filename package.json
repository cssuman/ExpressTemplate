{
    "name": "express-template",
    "version": "1.6.0",
    "description": "Express template with TypeScript",
    "author": {
        "name": "Suman Sharma",
        "email": "cs.sumansrm@gmail.com",
        "url": "https://sumansharma.name.np"
    },
    "license": "ISC",
    "main": "build/server.js",
    "scripts": {
        "setup": "node scripts/setup-env.mjs",
        "dev": "cross-env NODE_ENV=development tsx watch ./src/server.ts",
        "dev:debug": "cross-env NODE_ENV=development tsx watch --inspect ./src/server.ts",
        "build": "tsc && resolve-tspaths",
        "rebuild": "npm run clean && npm run build",
        "start": "cross-env NODE_ENV=production node build/server.js",
        "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "fix": "npm run lint:fix && npm run format",
        "check": "npm run typecheck && npm run lint && npm run format:check",
        "pm2:dev": "npm run build && pm2 start ecosystem.config.js --env development",
        "pm2:prod": "npm run build && pm2 start ecosystem.config.js --env production",
        "pm2:stop": "pm2 stop ecosystem.config.js",
        "pm2:logs": "pm2 logs",
        "docker:up": "node -e \"require('fs').existsSync('.env.production')||(console.error('\\n.env.production is missing. Create it first:\\n\\n  cp .env.example .env.production\\n'),process.exit(1))\" && docker compose up --build -d",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f server",
        "prepare": "husky"
    },
    "keywords": [
        "express",
        "typescript",
        "template",
        "boilerplate",
        "api",
        "prometheus",
        "i18next",
        "zod"
    ],
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^7.3.4",
        "@sendgrid/mail": "^8.1.4",
        "compression": "^1.8.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "cross-env": "^7.0.3",
        "dotenv-flow": "^4.1.0",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "express-ruid": "^1.1.5",
        "express-slow-down": "^2.0.3",
        "express-useragent": "^1.0.15",
        "handlebars": "^4.7.8",
        "helmet": "^8.0.0",
        "i18next": "^24.2.2",
        "i18next-fs-backend": "^2.6.0",
        "i18next-http-middleware": "^3.7.1",
        "morgan": "^1.10.0",
        "multer": "1.4.5-lts.1",
        "prom-client": "^15.1.3",
        "request-ip": "^3.3.0",
        "uuid": "^11.1.0",
        "winston": "^3.17.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@types/compression": "^1.7.5",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "4.17.17",
        "@types/express-useragent": "^1.0.5",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.13.9",
        "@types/request-ip": "^0.0.41",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-security": "^3.0.1",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "pm2": "^7.0.4",
        "prettier": "^3.5.3",
        "resolve-tspaths": "^0.8.23",
        "tsx": "^4.19.4",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.0"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "engines": {
        "node": ">=18.18.0",
        "npm": ">=9.0.0"
    }
}
